{
  "expo": {
    "name": "Latus",
    "slug": "Latus",
    "scheme": "latus.app",
    "version": "1.5.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "buildNumber": "11",
      "supportsTablet": false,
      "bundleIdentifier": "latus.app",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/splashDark.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to save and share images.",
        "NSPhotoLibraryAddUsageDescription": "This app needs to save images to your photos.",
        "NSContactsUsageDescription": "This lets you easily find and share content with your contacts directly from the app.",
        "FacebookAppID": "1433567004455755",
        "FacebookDisplayName": "latus",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "fb",
          "latus.app",
          "instagram",
          "instagram-stories",
          "fb",
          "latus.app",
          "fb",
          "instagram",
          "twitter",
          "tiktoksharesdk"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "fb1433567004455755",
              "latus.app"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "fb1433567004455755",
              "latus.app"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "latus.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash.png",
          "dark": {
            "image": "./assets/images/splashDark.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "fb",
            "instagram",
            "twitter",
            "tiktoksharesdk"
          ],
          "android": [
            "com.facebook.katana",
            "com.instagram.android",
            "com.twitter.android",
            "com.zhiliaoapp.musically"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38ef905d-694c-488a-8e18-c0cf3bd3fd8e"
      },
      "updates": {
        "url": "https://u.expo.dev/38ef905d-694c-488a-8e18-c0cf3bd3fd8e"
      }
    },
    "runtimeVersion": "1.5.5",
    "updates": {
      "url": "https://u.expo.dev/38ef905d-694c-488a-8e18-c0cf3bd3fd8e"
    }
  }
}
